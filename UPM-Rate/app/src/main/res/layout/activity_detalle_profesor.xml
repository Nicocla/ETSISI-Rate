<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fondo_pantalla">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvDetalleNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre Profesor"
            android:textColor="@color/texto_titulo"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvDetalleDept"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Departamento"
            android:textSize="18sp"
            android:textColor="@color/texto_subtitulo"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Análisis de competencias:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/texto_subtitulo"
            android:layout_marginBottom="8dp"/>

        <com.github.mikephil.charting.charts.RadarChart
            android:id="@+id/radarChart"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnVerResenas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VER TODAS LAS RESEÑAS"
            android:backgroundTint="#673AB7"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tu valoración detallada (Pulsa para desplegar):"
            android:textStyle="bold"
            android:textColor="@color/texto_titulo"
            android:layout_marginBottom="12dp"/>

        <include
            android:id="@+id/incHorario"
            layout="@layout/item_acordeon" />

        <include
            android:id="@+id/incMaterial"
            layout="@layout/item_acordeon" />

        <include
            android:id="@+id/incAtencion"
            layout="@layout/item_acordeon" />

        <include
            android:id="@+id/incTutorias"
            layout="@layout/item_acordeon" />

        <include
            android:id="@+id/incGuia"
            layout="@layout/item_acordeon" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Comentario opcional..."
            android:textColorHint="@color/texto_subtitulo"
            app:boxBackgroundColor="@color/fondo_tarjeta"
            app:boxStrokeColor="#2196F3"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etComentario"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:gravity="top"
                android:textColor="@color/texto_titulo"
                android:inputType="textMultiLine"/>
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnEnviar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="ENVIAR VALORACIÓN"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#2196F3"
            android:layout_marginBottom="32dp"/>

    </LinearLayout>
</ScrollView>