<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_pantalla">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="#2196F3"> <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

        <Button
            android:id="@+id/btnMisResenas"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Mis Reseñas"
            android:textSize="12sp"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="12dp"/>

        <ImageView
            android:id="@+id/btnLogout"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_lock_power_off"
            app:tint="#FFFFFF"
            android:contentDescription="Cerrar sesión"/>

    </LinearLayout>

    <EditText
        android:id="@+id/etBuscador"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="16dp"
        android:background="@color/fondo_tarjeta"
        android:hint="Buscar profesor o departamento..."
        android:textColorHint="@color/texto_subtitulo"
        android:textColor="@color/texto_titulo"
        android:paddingHorizontal="16dp"
        android:elevation="2dp"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="8dp"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/shimmerViewContainer"
            layout="@layout/shimmer_main_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProfesores"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:paddingHorizontal="8dp"
            android:clipToPadding="false"
            android:paddingBottom="80dp"/> <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddProfesor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:src="@android:drawable/ic_input_add"
        app:tint="@color/white"
        app:backgroundTint="#2196F3"
        android:visibility="gone"/>

    </FrameLayout>


</LinearLayout>